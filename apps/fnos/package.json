{
  "name": "@tabora/fnos",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "type": "module",
  "scripts": {
    "dev:frontend": "vp dev --config vite.frontend.config.ts",
    "dev:backend": "tsx backend/src/server.ts",
    "build:frontend": "vp build --config vite.frontend.config.ts",
    "serve:dist": "cross-env FNOS_FRONTEND_DIST=frontend/dist tsx backend/src/server.ts",
    "start": "pnpm run build:frontend && pnpm run serve:dist",
    "build": "pnpm run build:frontend"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.2",
    "@tabora/builtin-plugin-registry": "workspace:*",
    "@tabora/host-adapters": "workspace:*",
    "@tabora/plugin-api": "workspace:*",
    "@tabora/ui": "workspace:*",
    "@tabora/workbench-app": "workspace:*",
    "@tabora/workbench-shell": "workspace:*",
    "better-sqlite3": "^13.0.2",
    "fastify": "^5.11.2",
    "solid-js": "catalog:ui"
  },
  "devDependencies": {
    "@tabora/brand": "workspace:*",
    "@tabora/stylex-config": "workspace:*",
    "@tabora/tsconfig": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "cross-env": "^7.0.3",
    "fnpack": "^0.0.0",
    "tsx": "^4.19.2",
    "vite": "catalog:build",
    "vite-plugin-solid": "catalog:build"
  }
}
