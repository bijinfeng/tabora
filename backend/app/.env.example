# HTTP server
HOST=127.0.0.1
PORT=4000
CORS_ORIGINS=http://localhost:5173

# Storage: use sqlite locally; set DATABASE_CLIENT=postgres and DATABASE_URL for PostgreSQL.
DATABASE_CLIENT=sqlite
DATABASE_FILE=./data/tabora.db
# DATABASE_URL=postgres://tabora:tabora@localhost:5432/tabora
UPLOADS_DIR=./data/uploads

# Authentication: replace with a high-entropy secret (at least 32 characters).
BETTER_AUTH_SECRET=replace-with-a-high-entropy-secret-at-least-32-characters
BETTER_AUTH_URL=http://127.0.0.1:4000

# Built-in OpenAI-compatible AI providers. Each provider owns its API key, base URL, and models.
# Models are selected by providerId:modelId, e.g. openai:gpt-4.1-mini.
TABORA_AI_BUILTIN_PROVIDERS='[{"id":"openai","baseUrl":"https://api.openai.com/v1","apiKey":"replace-with-openai-key","models":["gpt-4.1-mini"]},{"id":"deepseek","baseUrl":"https://api.deepseek.com/v1","apiKey":"replace-with-deepseek-key","models":["deepseek-chat"]}]'
