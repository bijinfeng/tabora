# 服务监听
HOST=127.0.0.1
PORT=4000

# 允许的前端来源（admin 控制台）；逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# 数据库：本地开发用 sqlite，生产用 postgres
DATABASE_CLIENT=sqlite
# sqlite
DATABASE_FILE=./data/tabora.db
# postgres（DATABASE_CLIENT=postgres 时使用）
DATABASE_URL=postgres://tabora:tabora@localhost:5432/tabora

# better-auth 密钥与外部可访问地址
BETTER_AUTH_SECRET=change-me-in-production
BETTER_AUTH_URL=http://localhost:4000
