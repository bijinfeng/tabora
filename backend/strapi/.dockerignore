# Strapi-specific .dockerignore
# 当构建上下文为 backend/strapi/ 时使用

# Development files
node_modules/
.tmp/
.cache/
database/*.db

# Package-manager metadata unused by npm Docker builds
pnpm-lock.yaml
pnpm-workspace.yaml

# Environment files
.env
.env.local
.env.*.local

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output/
tests/
vitest.config.ts

# Build artifacts (if building from backend/strapi)
dist/
build/

# Local Docker deployment material
docker/
README.md

# Persistent runtime content must not be baked into the image
database/
public/uploads/

# Misc
.DS_Store
*.pem
