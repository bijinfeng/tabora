HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database — 开发默认 sqlite
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# 生产：DATABASE_CLIENT=postgres 并配置以下项
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=tabora
# DATABASE_USERNAME=tabora
# DATABASE_PASSWORD=
# DATABASE_SSL=false

# 认证 JWT 过期（任务 B1）
JWT_EXPIRES_IN=30d

# 附件上传 provider（任务 D2）：dev 默认 local；生产设 aws-s3
UPLOAD_PROVIDER=local
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_ACCESS_SECRET=
# AWS_BUCKET=
