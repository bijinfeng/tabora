{
  "name": "@tabora/official-plugins",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./styles.css": "./src/styles.css",
    "./workspace-default-preset": "./src/workspace-default-preset.ts",
    "./builtinSearchProviders": "./src/builtinSearchProviders.ts",
    "./builtinBackgroundProviders": "./src/builtinBackgroundProviders.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json",
      "./styles.css": "./dist/styles.css",
      "./workspace-default-preset": "./dist/workspace-default-preset.js",
      "./builtinSearchProviders": "./dist/builtinSearchProviders.js",
      "./builtinBackgroundProviders": "./dist/builtinBackgroundProviders.js"
    }
  },
  "scripts": {
    "build": "vp pack src/index.ts src/workspace-default-preset.ts src/builtinSearchProviders.ts src/builtinBackgroundProviders.ts",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@stylexjs/stylex": "catalog:style",
    "@tabora/auth": "workspace:*",
    "@tabora/host-adapters": "workspace:*",
    "@tabora/orchestrator": "workspace:*",
    "@tabora/platform-kernel": "workspace:*",
    "@tabora/plugin-ai-chat": "workspace:*",
    "@tabora/plugin-api": "workspace:*",
    "@tabora/plugin-notes": "workspace:*",
    "@tabora/plugin-quick-links": "workspace:*",
    "@tabora/plugin-todo": "workspace:*",
    "@tabora/plugin-weather": "workspace:*",
    "@tabora/theme": "workspace:*",
    "@tabora/ui": "workspace:*",
    "lucide-solid": "catalog:ui",
    "solid-js": "catalog:ui"
  },
  "devDependencies": {
    "@tabora/tsconfig": "workspace:*",
    "vite-plugin-solid": "catalog:build"
  }
}
