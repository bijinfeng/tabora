{
  "name": "@tabora/workbench-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./background-resolver": "./src/background-resolver.ts",
    "./default-workspace-seed": "./src/default-workspace-seed.ts",
    "./package.json": "./package.json",
    "./workbench-grid": "./src/workbench-grid.ts",
    "./workspace-portability": "./src/workspace-portability.ts",
    "./workspace-session": "./src/workspace-session.ts",
    "./workspace-transfer": "./src/workspace-transfer.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./background-resolver": "./dist/background-resolver.js",
      "./default-workspace-seed": "./dist/default-workspace-seed.js",
      "./package.json": "./package.json",
      "./workbench-grid": "./dist/workbench-grid.js",
      "./workspace-portability": "./dist/workspace-portability.js",
      "./workspace-session": "./dist/workspace-session.js",
      "./workspace-transfer": "./dist/workspace-transfer.js"
    }
  },
  "scripts": {
    "build": "vp pack src/index.ts src/background-resolver.ts src/default-workspace-seed.ts src/workbench-grid.ts src/workspace-portability.ts src/workspace-session.ts src/workspace-transfer.ts",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@dnd-kit/solid": "^0.4.0",
    "@solid-primitives/media": "catalog:ui",
    "@solid-primitives/timer": "catalog:ui",
    "@stylexjs/stylex": "catalog:style",
    "@tabora/brand": "workspace:*",
    "@tabora/host-adapters": "workspace:*",
    "@tabora/orchestrator": "workspace:*",
    "@tabora/platform-kernel": "workspace:*",
    "@tabora/plugin-api": "workspace:*",
    "@tabora/storage": "workspace:*",
    "@tabora/theme": "workspace:*",
    "@tabora/ui": "workspace:*",
    "@tabora/workbench-shell": "workspace:*",
    "es-toolkit": "catalog:toolkit",
    "lucide-solid": "catalog:ui",
    "solid-js": "catalog:ui"
  },
  "devDependencies": {
    "@tabora/auth": "workspace:*",
    "@tabora/sync": "workspace:*",
    "@tabora/tsconfig": "workspace:*",
    "@types/node": "catalog:node"
  }
}
