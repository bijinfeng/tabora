    "@tiptap/core": "catalog:ui",
    "@tiptap/extension-audio": "catalog:ui",
    "@tiptap/extension-file-handler": "catalog:ui",
    "@tiptap/extension-image": "catalog:ui",
    "@tiptap/extension-link": "catalog:ui",
    "@tiptap/extension-placeholder": "catalog:ui",
    "@tiptap/extension-task-item": "catalog:ui",
    "@tiptap/extension-task-list": "catalog:ui",
    "@tiptap/extension-text-align": "catalog:ui",
    "@tiptap/extension-underline": "catalog:ui",
    "@tiptap/pm": "catalog:ui",
    "@tiptap/starter-kit": "catalog:ui",
    "lucide-solid": "catalog:ui",
